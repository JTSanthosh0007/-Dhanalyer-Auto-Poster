# ─────────────────────────────────────────
#  Dhanalyer Auto Poster — Environment Setup
# ─────────────────────────────────────────

# 1. Anthropic API (for AI post generation)
#    Get from: https://console.anthropic.com
REACT_APP_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 2. LinkedIn API Credentials
#    Get from: https://www.linkedin.com/developers
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# 3. LinkedIn Access Token (60-day token)
#    Get from: https://www.linkedin.com/developers/tools/oauth/token-generator
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# 4. Your LinkedIn Person URN
#    Run: curl -H "Authorization: Bearer YOUR_TOKEN" https://api.linkedin.com/v2/userinfo
#    Copy the "sub" field value
LINKEDIN_PERSON_URN=urn:li:person:YOUR_URN_HERE

# 5. Server port
PORT=5000
